# Copy to .env.local and fill in. Only two variables are actually read by
# the app — everything the bots need lives in bots/.env instead.

# Shared secret for /mentor/admin/* — a single value, not per-admin accounts,
# since there's one operator (see lib/adminAuth.ts). If it is unset the admin
# area fails closed: nobody can log in, rather than everybody getting in.
ADMIN_SECRET=

# Shared secret the Telegram/Bale payment bots authenticate to /api/bot/* with.
# Must match BOT_API_SECRET in bots/.env.
BOT_API_SECRET=

# ---------------------------------------------------------------------------
# No longer used — safe to delete from an existing .env.local:
#
#   GOOGLE_SHEET_WEBHOOK_URL, GOOGLE_SHEET_SECRET
#       Leads were forwarded to a Google Sheet. That is gone; the record in
#       persistent/leads.json and the dashboard at /mentor/admin/leads (which
#       exports CSV) replace it. See lib/leads.ts.
#
#   KAVENEGAR_API_KEY
#       Nothing in the app reads it. The only Kavenegar integration is the
#       web-push SDK loaded in app/layout.tsx, which carries its own appId.
#
#   NEXT_PUBLIC_TELEGRAM_BOT_USERNAME, NEXT_PUBLIC_BALE_BOT_USERNAME
#       No longer referenced anywhere in src/.
