{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "HamMasir Design Tokens",
  "version": "2.0.0",
  "brandAnchors": {
    "_note": "Untouchable anchors — never shifted, only referenced",
    "sageTeal": "#5b9e94",
    "warmPeach": "#e8b99a",
    "warmCream": "#f6f1e9",
    "deepTealCharcoal": "#2c3a38",
    "warmAmber": "#d99a6c",
    "mutedTerracotta": "#b0644f"
  },
  "layer1_primitives": {
    "teal": {
      "50": "#eef6f4",
      "100": "#e3eeec",
      "200": "#c6ddd9",
      "300": "#9dc4bd",
      "400": "#74aca3",
      "500": "#5b9e94",
