      "700": "#376b64",
      "800": "#2f5753",
      "850": "#2f4a46",
      "well": "#3b6259",
      "900": "#2c3a38",
      "950": "#1d2726",
      "night300": "#93c7be",
      "night400": "#7db8ae"
    },
    "peach": {
      "50": "#fdf5ee",
      "100": "#fbeadd",
      "200": "#f6d9c2",
      "300": "#f0c5a5",
      "400": "#e8b99a",
      "500": "#dba783",
      "600": "#d99a6c",
      "700": "#b87a4e",
      "800": "#8a5c3c",
      "850": "#4a3a2c",
      "900": "#4a2e1d"
    },
    "cream": {
      "50": "#fffdf8",
      "100": "#fffcf6",
      "150": "#f4efe4",
      "200": "#f7f4ed",
      "300": "#f6f1e9",
      "400": "#f3e1cb",
      "500": "#f1ece0",
      "600": "#e7e1d3",
      "700": "#d6cdb6",
      "800": "#c4b697",
      "900": "#9a8e74"
    },
    "ink": {
      "50": "#f3f5f4",
      "100": "#e4e9e6",
      "200": "#c6d1cb",
      "300": "#9aa5a1",
      "400": "#6e7b78",
      "500": "#5c6b68",
      "600": "#3d4a47",
      "700": "#2c3a38",
      "800": "#222e2c",
      "900": "#1d2726"
    },
    "night": {
      "200": "#b9c4c0",
      "300": "#8b9794",
      "700": "#33413f",
      "750": "#3a4a47",
      "800": "#2a3634",
      "900": "#202b29",
      "950": "#161e1d"
    },
    "success": {
      "50": "#f0f7f1",
      "100": "#e8f3ea",
      "200": "#c9e2d1",
      "300": "#a9cfb6",
      "400": "#8fc3a5",
      "500": "#6fa98c",
      "600": "#55836a",
      "700": "#43765a",
      "800": "#335844",
      "850": "#2c4438",
      "900": "#22392c"
    },
    "alert": {
      "50": "#fbf3ea",
      "100": "#f8e9da",
      "200": "#f3d8bc",
      "300": "#eac193",
      "400": "#e0aa7e",
      "500": "#d99a6c",
      "600": "#c0804f",
      "700": "#a06a3e",
      "800": "#7d5230",
      "900": "#4f3420"
    },
    "danger": {
      "50": "#f9efeb",
      "100": "#f5e4de",
      "200": "#e6c6b9",
      "300": "#d8a28e",
      "400": "#cf8a73",
      "500": "#b0644f",
      "600": "#96543f",
      "700": "#7e4536",
      "800": "#5f3527",
      "900": "#3d231a",
      "950": "#3b2620"
    },
    "info": {
      "50": "#eef4f4",
      "100": "#dce9e9",
      "200": "#b8d3d3",
      "300": "#8cb4b5",
      "400": "#659294",
      "500": "#4e7779",
      "600": "#3d5f61",
      "700": "#334e50",
      "800": "#2b4142",
      "900": "#1f3031",
      "950": "#233837"
    }
  },
  "layer2_semantic_light": {
    "bg": {
      "canvas": "{cream.300}",
      "surface": "{cream.100}",
      "surface-raised": "{cream.50}",
      "surface-sunken": "{cream.500}",
      "primary": "{teal.500}",
      "secondary": "{peach.400}",
      "disabled": "{cream.500}"
    },
    "text": {
      "primary": "{ink.700}",
      "secondary": "{ink.500}",
      "tertiary": "{ink.500}",
      "inverse": "{cream.100}",
      "disabled": "{ink.300}",
      "link": "{teal.700}",
      "success": "{success.700}",
      "warning": "{alert.800}",
      "danger": "{danger.700}",
      "info": "{info.700}"
    },
    "border": {
      "default": "{cream.600}",
      "subtle": "{cream.500}",
      "strong": "{ink.500}",
      "focus": "{teal.500}",
      "disabled": "{cream.600}",
      "danger": "{danger.500}",
      "success": "{success.600}"
    },
    "action": {
      "primary": "{teal.700}",
      "primary-hover": "{teal.800}",
      "primary-pressed": "{teal.900}",
      "primary-foreground": "#ffffff",
      "secondary": "{peach.400}",
      "secondary-hover": "{peach.500}",
      "secondary-pressed": "{peach.600}",
      "secondary-foreground": "{peach.900}",
      "ghost-hover": "{teal.100}",
      "ghost-pressed": "{teal.200}"
    },
    "feedback": {
      "success": { "bg": "{success.50}", "text": "{success.900}", "border": "{success.600}" },
      "warning": { "bg": "{alert.50}", "text": "{alert.900}", "border": "{alert.700}" },
      "danger": { "bg": "{danger.50}", "text": "{danger.900}", "border": "{danger.600}" },
      "info": { "bg": "{info.50}", "text": "{info.900}", "border": "{info.600}" }
    }
  },
  "layer2_semantic_dark_night_walk": {
    "_mood": "night walk together — warm charcoal-teal night, never pure black; cream text, never pure white",
    "bg": {
      "canvas": "{night.900}",
      "surface": "{night.800}",
      "surface-raised": "{night.750}",
      "surface-sunken": "{night.950}",
      "primary": "{teal.night400}",
      "secondary": "{peach.400}",
      "disabled": "{night.700}"
    },
    "text": {
      "primary": "{cream.150}",
      "secondary": "{night.200}",
      "tertiary": "{night.300}",
      "inverse": "{ink.900}",
      "disabled": "{night.300}",
      "link": "{teal.night400}",
      "success": "{success.400}",
      "warning": "{alert.400}",
      "danger": "{danger.400}",
      "info": "{info.300}"
    },
    "border": {
      "default": "{ink.600}",
      "subtle": "{night.800}",
      "strong": "{night.300}",
      "focus": "{teal.night400}",
      "disabled": "{ink.600}",
      "danger": "{danger.400}",
      "success": "{success.400}"
    },
    "action": {
      "primary": "{teal.night400}",
      "primary-hover": "{teal.night300}",
      "primary-pressed": "{teal.300}",
      "primary-foreground": "{ink.900}",
      "secondary": "{peach.400}",
      "secondary-hover": "{peach.500}",
      "secondary-pressed": "{peach.600}",
      "secondary-foreground": "{peach.900}",
      "ghost-hover": "{teal.850}",
      "ghost-pressed": "{night.700}"
    },
    "feedback": {
      "success": { "bg": "{success.850}", "text": "{success.200}", "border": "{success.400}" },
      "warning": { "bg": "{peach.850}", "text": "{peach.100}", "border": "{alert.400}" },
      "danger": { "bg": "{danger.950}", "text": "{danger.400}", "border": "{danger.400}" },
      "info": { "bg": "{info.950}", "text": "{info.300}", "border": "{info.400}" }
    }
  },
  "contrast_spot_checks": {
    "_note": "Measured WCAG ratios (relative luminance), not estimates",
    "light": {
      "white_on_action_primary_teal700": 6.09,
      "ink900_on_action_secondary_peach400": 6.96,
      "ink700_on_canvas": 10.56,
      "ink500_on_canvas": 4.97,
      "teal700_link_on_canvas": 5.41,
      "white_on_sage500_DEPRECATED_for_text": 3.11
    },
    "dark": {
      "cream150_on_night900": 12.73,
      "night200_on_night900": 8.14,
      "ink900_on_tealNight400": 6.81
    }
  },
  "layer3_component_rules": [
    "Components bind ONLY to semantic tokens (bg-canvas, action-primary, feedback-*-bg, ...)",
    "Never reference primitives directly from components",
    "Text-bearing actions use action-* (AA); brand primary-500 is decorative/large-text only",
    "Feedback bg + text + border ship together, never split; never color alone (icon + text + role)",
    "Dark mode flips semantic layer only",
    "No 0-radius corners; min tap target 48px; calm motion only"
  ],
  "spacing": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radii": { "none": 0, "xs": 4, "sm": 12, "md": 16, "lg": 20, "xl": 24, "2xl": 32, "full": 9999 },
  "radiusSemantic": { "button": "md", "input": "md", "card": "lg", "dialog": "xl", "sheet": "xl", "badge": "sm", "chip": "full", "avatar": "full" },
  "borderWidths": { "none": 0, "hairline": 1, "default": 1, "medium": 1.5, "strong": 2 },
  "elevation": { "0": "none", "1": "subtle", "2": "card", "3": "floating", "4": "dialog" },
  "shadows": {
    "none": "elevation-0",
    "card": "elevation-2",
    "dropdown": "elevation-3",
    "popover": "elevation-3",
    "dialog": "elevation-4",
    "sheet": "elevation-4",
    "floating": "elevation-3",
    "lifted": "elevation-3 (legacy alias)",
    "brand": "primary/selected glow only"
  },
  "motion": {
    "micro": "150ms",
    "standard": "250ms",
    "entrance": "350ms",
    "sheet": "340ms",
    "easing": "cubic-bezier(0.22, 0.61, 0.36, 1)"
  },
  "typography": {
    "display": { "size": 30, "weight": "Bold", "leading": 1.25 },
    "h1": { "size": 24, "weight": "Bold", "leading": 1.3 },
    "h2": { "size": 20, "weight": "SemiBold", "leading": 1.35 },
    "h3": { "size": 17, "weight": "SemiBold", "leading": 1.4 },
    "body": { "size": 16, "weight": "Regular", "leading": 1.7 },
    "caption": { "size": 13, "weight": "Regular", "leading": 1.6 },
    "label": { "size": 12, "weight": "Medium", "leading": 1.5 }
  }
}
