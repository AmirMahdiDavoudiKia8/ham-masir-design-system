{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "HamMasir Design Tokens",
  "version": "1.0.0",
  "layer1_primitives": {
    "teal": {
      "50": "#eef6f4",
      "100": "#e3eeec",
      "500": "#5b9e94",
      "600": "#46857c",
      "900": "#2c3a38"
    },
    "peach": {
      "100": "#fbeadd",
      "400": "#e8b99a",
      "500": "#dba783",
      "900": "#4a2e1d"
    },
    "cream": {
      "surface": "#fffcf6",
      "background": "#f6f1e9",
      "sunken": "#f1ece0",
      "hairline": "#e7e1d3"
    },
    "ink": {
      "DEFAULT": "#2c3a38",
      "muted": "#5c6b68",
      "faint": "#9aa5a1"
    }
  },
  "layer2_semantic_light": {
    "bg": { "background": "{cream.background}", "surface": "{cream.surface}", "surface-alt": "{cream.sunken}" },
    "fg": { "DEFAULT": "{ink.DEFAULT}", "muted": "{ink.muted}", "faint": "{ink.faint}" },
    "brand": { "primary": "{teal.500}", "primary-hover": "{teal.600}", "secondary": "{peach.400}" }
  },
  "layer2_semantic_dark_night_walk": {
    "_mood": "night walk together — warm charcoal-teal night, never pure black; cream text, never pure white",
    "bg": { "background": "#202b29", "surface": "#2a3634", "surface-alt": "#33413f" },
    "fg": { "DEFAULT": "#f4efe4", "muted": "#b9c4c0", "faint": "#8b9794" },
    "brand": { "primary": "#7db8ae", "primary-hover": "#93c7be", "primary-foreground": "#1d2726", "secondary": "{peach.400}" },
    "functional": { "verified": "#7db8ae", "success": "#8fc3a5", "alert": "#e0aa7e", "danger": "#cf8a73", "danger-foreground": "#1d2726" },
    "line": { "border": "#3d4a47" },
    "overlay": { "scrim": "rgba(15, 22, 21, 0.6)" }
  },
  "layer3_component_rules": [
    "Components bind ONLY to semantic tokens (bg/surface, fg/muted, primary, border...)",
    "Never reference primitives directly from components",
    "Dark mode flips semantic layer only",
    "No 0-radius corners; min tap target 48px; calm motion only"
  ],
  "spacing": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radii": { "sm": 12, "md": 16, "lg": 20, "full": 9999 },
  "motion": {
    "micro": "150ms",
    "standard": "250ms",
    "entrance": "350ms",
    "sheet": "340ms",
    "easing": "cubic-bezier(0.22, 0.61, 0.36, 1)"
  },
  "typography": {
    "display": { "size": 30, "weight": "Bold", "leading": 1.25 },
    "h1": { "size": 24, "weight": "Bold", "leading": 1.3 },
    "h2": { "size": 20, "weight": "SemiBold", "leading": 1.35 },
    "h3": { "size": 17, "weight": "SemiBold", "leading": 1.4 },
    "body": { "size": 16, "weight": "Regular", "leading": 1.7 },
    "caption": { "size": 13, "weight": "Regular", "leading": 1.6 },
    "label": { "size": 12, "weight": "Medium", "leading": 1.5 }
  }
}
